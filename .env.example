# Copy this file to .env and fill in the public Firebase web-app values
# (Firebase Console > Project Settings > General > Your apps > SDK setup).
# These values are used by the browser; .env is gitignored.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Supabase public project URL and anon/publishable key. The service-role key
# must only be set in Netlify's server-side environment, never in VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional prefilled admin email for /admin. Enable Email/Password sign-in
# and create this user under Firebase Console > Authentication > Users.
# Replace the example email in firestore.rules with this exact address
# before deploying Firestore rules.
VITE_ADMIN_EMAIL=admin@example.com
