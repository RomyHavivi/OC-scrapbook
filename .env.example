# Copy this file to .env and fill in real values from your Firebase project
# (Firebase Console > Project Settings > General > Your apps > SDK setup).
# .env is gitignored — never commit real keys.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional prefilled admin email for /admin. Enable Email/Password sign-in
# and create this user under Firebase Console > Authentication > Users.
# Also replace the example email in firestore.rules and storage.rules with
# this exact address before deploying those rules.
VITE_ADMIN_EMAIL=admin@example.com
