# Emulator-only Firebase identifiers; these are fake and point the app to local services.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-scrapbook.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-scrapbook
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:demo

VITE_ADMIN_EMAIL=admin@example.com
VITE_USE_FIREBASE_EMULATORS=true
